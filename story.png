<span>(function(){</span>
<span>  'use strict';</span>
<span>  // 因为更新了用户档案，清理了旧的数据键名，使用全新的 v3 避免冲突</span>
<span>  var KEY_DIARY = 'herLittleAtlas.entries.v3';</span>
