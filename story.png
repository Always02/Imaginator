958 15.3434 1.1128 14.3042 0.876343 12.8866L0.630249 11.411L2.05408 11.1747L2.29919 12.6493C2.41973 13.3713 3.04475 13.9001 3.77673 13.9003H12.223C12.9551 13.9002 13.58 13.3713 13.7006 12.6493L13.9457 11.1747L15.3695 11.411ZM8.72205 8.994C8.77717 8.93934 8.83792 8.88106 8.90271 8.81627L12.4828 5.23424L13.5043 6.25572L9.92224 9.8358C9.6395 10.1185 9.38763 10.3732 9.15857 10.5575C8.91892 10.7503 8.63953 10.9224 8.2865 10.9784C8.09711 11.0083 7.90363 11.0083 7.71423 10.9784C7.36106 10.9224 7.0809 10.7503 6.84119 10.5575C6.61215 10.3732 6.36022 10.1185 6.07751 9.8358L2.49646 6.25572L3.51697 5.23424L7.09705 8.81627C7.16219 8.88142 7.22331 8.94006 7.27869 8.99498V1.3065H8.72205V8.994Z" fill="currentColor"></path></svg></div><span class="ds-button__content"><span class="code-info-button-text">下载</span></span></div><div class="ae809fef"></div><div role="button" class="ds-button ds-button--borderlessNeutral ds-button--borderless ds-button--capsule ds-button--xs ds-button--icon-relative-m ds-button--min-width" tabindex="0"><div class="ds-button__background"></div><div class="ds-button__icon"><svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M14.1446 8C14.1446 4.6062 11.3938 1.85539 8 1.85539C4.6062 1.85539 1.85539 4.6062 1.85539 8C1.85539 11.3938 4.6062 14.1446 8 14.1446C11.3938 14.1446 14.1446 11.3938 14.1446 8ZM15.511 8C15.511 12.148 12.148 15.511 8 15.511C3.85202 15.511 0.489014 12.148 0.489014 8C0.489014 3.85202 3.85202 0.489014 8 0.489014C12.148 0.489014 15.511 3.85202 15.511 8Z" fill="currentColor"></path><path d="M10.5617 8.42578C10.852 8.21614 10.852 7.78386 10.5617 7.57422L7.25708 5.18751C6.90974 4.93666 6.42436 5.18484 6.42436 5.61329V10.3867C6.42436 10.8152 6.90974 11.0633 7.25708 10.8125L10.5617 8.42578Z" fill="currentColor"></path></svg></div><span class="ds-button__content"><span class="code-info-button-text">运行</span></span></div></div></div></div></div></div><pre><span><span class="token doctype"><span class="token punctuation">&lt;!</span><span class="token doctype-tag">DOCTYPE</span> <span class="token name">html</span><span class="token punctuation">&gt;</span></span></span>
<span><span class="token tag"><span class="token tag"><span class="token punctuation">&lt;</span>html</span> <span class="token attr-name">lang</span><span class="token attr-value"><span class="token punctuation attr-equals">=</span><span class="token punctuation">"</span>zh-CN<span class="token punctuation">"</span></span><span class="token punctuation">&gt;</span></span></span>
<span><span class="token tag"><span class="token tag"><span class="token punctuation">&lt;</span>head</span><span class="token punctuation">&gt;</span></span></span>
<span><span class="token tag"><span class="token tag"><span class="token punctuation">&lt;</span>meta</span> <span class="token attr-name">charset</span><span class="token attr-value"><span class="token punctuation attr-equals">=</span><span class="token punctuation">"</span>UTF-8<span class="token punctuation">"</span></span><span class="token punctuation">&gt;</span></span></span>
<span><span class="token tag"><span class="token tag"><span class="token punctuation">&lt;</span>meta</span> <span class="token attr-name">name</span><span class="token attr-value"><span class="token punctuation attr-equals">=</span><span class="token punctuation">"</span>viewport<span class="token punctuation">"</span></span> <span class="token attr-name">content</span><span class="token attr-value"><span class="token punctuation attr-equals">=</span><span class="token punctuation">"</span>width=device-width, initial-scale=1, viewport-fit=cover<span class="token punctuation">"</span></span><span class="token punctuation">&gt;</span></span></span>
<span><span class="token tag"><span class="token tag"><span class="token punctuation">&lt;</span>meta</span> <span class="token attr-name">name</span><span class="token attr-value"><span class="token punctuation attr-equals">=</span><span class="token punctuation">"</span>theme-color<span class="token punctuation">"</span></span> <span class="token attr-name">content</span><span class="token attr-value"><span class="token punctuation attr-equals">=</span><span class="token punctuation">"</span>#ffffff<span class="token punctuation">"</span></span><span class="token punctuation">&gt;</span></span></span>
<span><span class="token tag"><span class="token tag"><span class="token punctuation">&lt;</span>title</span><span class="token punctuation">&gt;</span></span>生活在别处<span class="token tag"><span class="token tag"><span class="token punctuation">&lt;/</span>title</span><span class="token punctuation">&gt;</span></span></span>
<span></span>
<span><span class="token tag"><span class="token tag"><span class="token punctuation">&lt;</span>link</span> <span class="token attr-name">rel</span><span class="token attr-value"><span class="token punctuation attr-equals">=</span><span class="token punctuation">"</span>apple-touch-icon<span class="token punctuation">"</span></span> <span class="token attr-name">href</span><span class="token attr-value"><span class="token punctuation attr-equals">=</span><span class="token punctuation">"</span>./story.svg<span class="token punctuation">"</span></span><span class="token punctuation">&gt;</span></span></span>
<span><span class="token tag"><span class="token tag"><span class="token punctuation">&lt;</span>link</span> <span class="token attr-name">rel</span><span class="token attr-value"><span class="token punctuation attr-equals">=</span><span class="token punctuation">"</span>icon<span class="token punctuation">"</span></span> <span class="token attr-name">type</span><span class="token attr-value"><span class="token punctuation attr-equals">=</span><span class="token punctuation">"</span>image/svg+xml<span class="token punctuation">"</span></span> <span class="token attr-name">href</span><span class="token attr-value"><span class="token punctuation attr-equals">=</span><span class="token punctuation">"</span>./story.svg<span class="token punctuation">"</span></span><span class="token punctuation">&gt;</span></span></span>
<span></span>
<span><span class="token tag"><span class="token tag"><span class="token punctuation">&lt;</span>style</span><span class="token punctuation">&gt;</span></span></span>
<span>:root{--ink:#111;--muted:#888;--line:#eaeaea;--soft:#f9f9f9;--white:#fff;}</span>
<span>*{box-sizing:border-box}</span>
<span>html{scroll-behavior:smooth}</span>
<span>body{margin:0;background:var(--white);color:var(--ink);font-family:-apple-system,BlinkMacSystemFont,"SF Pro Text","Helvetica Neue","PingFang SC",sans-serif;font-size:15px;line-height:1.6;-webkit-font-smoothing:antialiased;}</span>
<span>button,input,textarea{font:inherit;color:inherit;font-size:16px !important;} /* 锁定 16px 防止 Safari 放大 */</span>
<span>button{cursor:pointer;touch-action:manipulation;border:none;background:none;}</span>
<span>input:focus, textarea:focus, button:focus { outline: none; }</span>
<span></span>
<span>/* ====== 加载动画：3D 翻书 ====== */</span>
<span>#loader {</span>
<span>  position: fixed; top: 0; left: 0; width: 100%; height: 100%;</span>
<span>  background: var(--white); z-index: 9999;</span>
<span>  display: flex; flex-direction: column; align-items: center; justify-content: center;</span>
<span>  transition: opacity 0.8s ease;</span>
<span>}</span>
<span>#loader.fade-out { opacity: 0; pointer-events: none; }</span>
<span>.book-wrap { perspective: 1200px; margin-bottom: 20px; }</span>
<span>.book-3d {</span>
<span>  width: 50px; height: 70px; position: relative; transform-style: preserve-3d;</span>
<span>  background: #fff; border: 2px solid var(--ink); border-radius: 2px;</span>
<span>}</span>
<span>.book-page {</span>
<span>  position: absolute; top: -2px; left: 50%; width: 100%; height: calc(100% + 4px);</span>
<span>  background: #fff; border: 2px solid var(--ink); border-radius: 2px;</span>
<span>  transform-origin: left center;</span>
<span>  animation: realFlip 2.5s infinite cubic-bezier(0.4, 0, 0.2, 1);</span>
<span>}</span>
<span>@keyframes realFlip {</span>
<span>  0% { transform: rotateY(0deg); }</span>
<span>  20% { transform: rotateY(0deg); }</span>
<span>  80% { transform: rotateY(-180deg); }</span>
<span>  100% { transform: rotateY(-180deg); }</span>
<span>}</span>
<span>.loader-text { font-size: 12px; letter-spacing: 0.2em; color: var(--muted); text-transform: uppercase; }</span>
<span></span>
<span>/* ====== 日历过渡页 ====== */</span>
<span>#calendarOverlay {</span>
<span>  position: fixed; top: 0; left: 0; width: 100%; height: 100%;</span>
<span>  background: var(--white); z-index: 9000;</span>
<span>  display: flex; flex-direction: column; align-items: center; justify-content: center;</span>
<span>  transition: opacity 1.2s cubic-bezier(0.4, 0, 0.2, 1);</span>
<span>  padding: 40px;</span>
<span>}</span>
<span>#calendarOverlay.fade-out { opacity: 0; pointer-events: none; }</span>
<span>.cal-month-year { font-size: 13px; letter-spacing: 0.3em; color: var(--muted); margin-bottom: 10px; text-transform: uppercase; }</span>
<span>.cal-day { font-size: 80px; font-weight: 800; line-height: 1; letter-spacing: -0.05em; margin-bottom: 20px; }</span>
<span>.cal-festival { font-size: 15px; font-weight: 600; letter-spacing: 0.1em; margin-bottom: 50px; }</span>
<span>.cal-line { width: 30px; height: 1px; background: var(--ink); margin-bottom: 40px; }</span>
<span>.cal-quote { font-size: 16px; line-height: 2; color: #333; max-width: 280px; text-align: justify; }</span>
<span>.cal-author { font-size: 13px; color: var(--muted); margin-top: 15px; align-self: flex-end; }</span>
<span>.cal-tap { position: absolute; bottom: 40px; font-size: 12px; color: #aaa; animation: pulse 2s infinite; }</span>
<span>@keyframes pulse { 0%,100%{opacity: 0.3;} 50%{opacity: 1;} }</span>
<span></span>
<span>/* ====== 主应用 ====== */</span>
<span>.app { max-width: 680px; margin: 0 auto; min-height: 100vh; padding: 0 20px 100px; opacity: 0; transition: opacity 1s; }</span>
<span>.app.loaded { opacity: 1; }</span>
<span></span>
<span>.topbar { height: 60px; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid var(--line); position: sticky; top: 0; background: rgba(255,255,255,.95); backdrop-filter: blur(10px); z-index: 100; }</span>
<span>.brand { font-size: 18px; font-weight: 700; letter-spacing: -.04em; }</span>
<span>.top-actions { display: flex; gap: 12px; }</span>
<span>.plain-btn { font-size: 13px; color: var(--muted); padding: 5px; }</span>
<span></span>
<span>.main-tabs { display: flex; border-bottom: 1px solid var(--line); height: 50px; margin-bottom: 25px; }</span>
<span>.main-tab { flex: 1; font-size: 16px; font-weight: 600; color: var(--muted); position: relative; }</span>
<span>.main-tab.active { color: var(--ink); }</span>
<span>.main-tab.active::after { content: ""; position: absolute; bottom: -1px; left: 0; right: 0; height: 2px; background: var(--ink); }</span>
<span></span>
<span>/* 日记版块 */</span>
<span>.hero h1 { font-size: 28px; letter-spacing: -.05em; margin: 20px 0 10px; font-weight: 700; }</span>
<span>.hero p { font-size: 15px; color: #666; margin-bottom: 30px; }</span>
<span>.stats { display: flex; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); padding: 15px 0; margin-bottom: 20px; }</span>
<span>.stat { flex: 1; border-right: 1px solid var(--line); padding-left: 15px; }</span>
<span>.stat:first-child { padding-left: 0; border: none; }</span>
<span>.stat:last-child { border: none; }</span>
<span>.stat strong { display: block; font-size: 22px; font-weight: 700; }</span>
<span>.stat span { font-size: 12px; color: var(--muted); }</span>
<span>.search-bar { width: 100%; border: none; background: var(--soft); border-radius: 10px; padding: 12px 15px; margin-bottom: 20px; }</span>
<span></span>
<span>.entry { padding: 20px 0; border-bottom: 1px solid var(--line); }</span>
<span>.entry-date { font-size: 12px; color: var(--muted); margin-bottom: 6px; }</span>
<span>.entry-place { font-size: 20px; font-weight: 700; margin: 5px 0 10px; }</span>
<span>.entry-body { font-size: 15px; line-height: 1.8; white-space: pre-wrap; margin-bottom: 10px; }</span>
<span>.entry-tags { display: flex; gap: 8px; margin-bottom: 10px; flex-wrap: wrap; }</span>
<span>.tag { font-size: 12px; color: var(--muted); border: 1px solid var(--line); padding: 3px 8px; border-radius: 12px; }</span>
<span>.entry-actions { display: flex; gap: 15px; }</span>
<span>.entry-actions button { font-size: 12px; color: var(--muted); }</span>
<span></span>
<span>/* 写日记表单 */</span>
<span>.form-group { margin-bottom: 20px; }</span>
<span>.form-group label { display: block; font-size: 14px; font-weight: 600; margin-bottom: 8px; }</span>
<span>.form-input, .form-textarea { width: 100%; border: 1px solid var(--line); border-radius: 10px; padding: 12px 15px; background: var(--white); }</span>
<span>.form-textarea { min-height: 180px; resize: vertical; }</span>
<span>.mode-switch { display: flex; gap: 10px; margin-bottom: 20px; }</span>
<span>.mode-btn { flex: 1; padding: 10px; background: var(--soft); border-radius: 8px; font-size: 14px; color: var(--muted); font-weight: 600; }</span>
<span>.mode-btn.active { background: var(--white); border: 1px solid var(--ink); color: var(--ink); }</span>
<span></span>
<span>/* 想象版块 */</span>
<span>.box-list { display: flex; flex-direction: column; }</span>
<span>.box-card { padding: 20px 0; border-bottom: 1px solid var(--line); display: flex; justify-content: space-between; align-items: center; }</span>
<span>.box-title { font-size: 18px; font-weight: 700; }</span>
<span>.box-desc { font-size: 13px; color: var(--muted); margin-top: 4px; }</span>
<span>.add-box-btn { padding: 20px 0; font-size: 16px; font-weight: 600; color: var(--muted); text-align: center; border-bottom: 1px solid var(--line); }</span>
<span></span>
<span>/* 盒子内部 Threads 风格 */</span>
<span>.box-header { display: flex; align-items: center; margin-bottom: 20px; padding-bottom: 10px; border-bottom: 1px solid var(--line); }</span>
<span>.back-btn { font-size: 24px; margin-right: 10px; font-weight: 300; }</span>
<span>.box-header h2 { font-size: 20px; font-weight: 700; }</span>
<span>.core-imagine { margin-bottom: 30px; }</span>
<span>.core-input { width: 100%; border: none; background: var(--soft); border-radius: 12px; padding: 15px; font-size: 16px; font-weight: 600; line-height: 1.6; resize: none; }</span>
<span>.core-input:focus { background: #f0f0f0; }</span>
<span></span>
<span>/* 左侧细线流 */</span>
<span>.thread-feed { display: flex; flex-direction: column; margin-bottom: 20px; }</span>
<span>.thread-item { position: relative; padding: 15px 0 15px 20px; border-left: 1px solid #e0e0e0; margin-left: 5px; }</span>
<span>.thread-item::before { content: ""; position: absolute; left: -4px; top: 22px; width: 7px; height: 7px; border-radius: 50%; background: var(--white); border: 1px solid var(--ink); }</span>
<span>.thread-text { font-size: 15px; line-height: 1.6; white-space: pre-wrap; margin-bottom: 10px; }</span>
<span>.thread-img { max-width: 100%; border-radius: 8px; margin-top: 8px; border: 1px solid var(--line); }</span>
<span>.thread-actions { display: flex; gap: 15px; margin-top: 10px; }</span>
<span>.thread-actions button { font-size: 12px; color: var(--muted); }</span>
<span></span>
<span>.add-detail { position: relative; padding-left: 20px; border-left: 1px solid transparent; margin-left: 5px; }</span>
<span>.add-textarea { width: 100%; border: none; background: var(--soft); font-size: 15px; resize: none; padding: 15px; min-height: 80px; border-radius: 12px; margin-bottom: 10px; }</span>
<span>.add-actions { display: flex; justify-content: space-between; align-items: center; }</span>
<span>.add-img-btn { font-size: 24px; color: var(--muted); cursor: pointer; }</span>
<span>.add-submit { background: var(--ink); color: var(--white); padding: 6px 16px; border-radius: 15px; font-size: 14px; font-weight: 600; }</span>
<span></span>
<span>/* 悬浮球 */</span>
<span>.fab {</span>
<span>  position: fixed; right: 20px; bottom: 40px; width: 56px; height: 56px;</span>
<span>  background: var(--ink); border-radius: 50%; z-index: 800;</span>
<span>  box-shadow: 0 4px 15px rgba(0,0,0,0.2);</span>
<span>  display: flex; align-items: center; justify-content: center;</span>
<span>  cursor: grab; touch-action: none; transition: transform 0.1s;</span>
<span>}</span>
<span>.fab:active { cursor: grabbing; transform: scale(0.95); }</span>
<span>.fab svg { width: 24px; height: 24px; fill: none; stroke: var(--white); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }</span>
<span></span>
<span>/* 弹窗与提示 */</span>
<span>.popup-menu { position: absolute; top: 130px; left: 50%; transform: translateX(-50%); background: var(--white); border: 1px solid var(--line); border-radius: 12px; box-shadow: 0 10px 30px rgba(0,0,0,0.08); z-index: 200; display: none; flex-direction: column; padding: 8px; width: 200px; }</span>
<span>.popup-menu.show { display: flex; }</span>
<span>.popup-menu button { text-align: left; padding: 12px 15px; font-size: 16px; border-radius: 8px; font-weight: 500; }</span>
<span>.popup-menu button:hover { background: var(--soft); }</span>
<span>.toast { position: fixed; left: 50%; bottom: 100px; transform: translateX(-50%); background: var(--ink); color: var(--white); padding: 10px 20px; border-radius: 20px; font-size: 14px; opacity: 0; pointer-events: none; transition: opacity 0.3s; z-index: 9999; white-space: nowrap; }</span>
<span>.toast.show { opacity: 1; }</span>
<span>.hidden { display: none !important; }</span>
<span></span>
<span>/* 首次欢迎界面 */</span>
<span>#welcomeOverlay { position: fixed; top:0; left:0; width:100%; height:100%; background:var(--white); z-index:9500; display:flex; flex-direction:column; align-items:center; justify-content:center; padding:30px; text-align:center; }</span>
<span>#welcomeOverlay h2 { font-size: 24px; margin-bottom: 10px; }</span>
<span>#welcomeOverlay p { color: var(--muted); margin-bottom: 30px; font-size: 15px; }</span>
<span>.welcome-input { width: 100%; max-width: 300px; border: none; border-bottom: 1px solid var(--ink); font-size: 24px; text-align: center; padding: 10px; margin-bottom: 30px; background: transparent; font-weight: 700; }</span>
<span>.gender-select { display: flex; gap: 15px; margin-bottom: 40px; }</span>
<span>.gender-btn { padding: 8px 20px; border: 1px solid var(--line); border-radius: 20px; font-size: 15px; color: var(--muted); transition: all 0.2s; }</span>
<span>.gender-btn.active { border-color: var(--ink); color: var(--ink); background: var(--soft); }</span>
<span><span class="token tag"><span class="token tag"><span class="token punctuation">&lt;/</span>style</span><span class="token punctuation">&gt;</span></span></span>
<span><span class="token tag"><span class="token tag"><span class="token punctuation">&lt;/</span>head</span><span class="token punctuation">&gt;</span></span></span>
<span><span class="token tag"><span class="token tag"><span class="token punctuation">&lt;</span>body</span><span class="token punctuation">&gt;</span></span></span>
<span></span>
<span><span class="token comment">&lt;!-- 欢迎界面 --&gt;</span></span>
<span><span class="token tag"><span class="token tag"><span class="token punctuation">&lt;</span>div</span> <span class="token attr-name">id</span><span class="token attr-value"><span class="token punctuation attr-equals">=</span><span class="token punctuation">"</span>welcomeOverlay<span class="token punctuation">"</span></span> <span class="token attr-name">class</span><span class="token attr-value"><span class="token punctuation attr-equals">=</span><span class="token punctuation">"</span>hidden<span class="token punctuation">"</span></span><span class="token punctuation">&gt;</span></span></span>
<span>  <span class="token tag"><span class="token tag"><span class="token punctuation">&lt;</span>h2</span><span class="token punctuation">&gt;</span></span>欢迎来到别处<span class="token tag"><span class="token tag"><span class="token punctuation">&lt;/</span>h2</span><span class="token punctuation">&gt;</span></span></span>
<span>  <span class="token tag"><span class="token tag"><span class="token punctuation">&lt;</span>p</span><span class="token punctuation">&gt;</span></span>这是一个脱离此刻的想象世界，请先设定你的档案。<span class="token tag"><span class="token tag"><span class="token punctuation">&lt;/</span>p</span><span class="token punctuation">&gt;</span></span></span>
